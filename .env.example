# Port publik frontend Docker.
FRONTEND_PORT=3000

# URL backend yang dipakai Next.js di sisi server.
# Docker lokal (backend berjalan pada host):
API_BASE_URL=http://host.docker.internal/koranku/api/v1
# Docker production (backend berada pada external network yang sama):
# API_BASE_URL=http://koranku-backend/api/v1

# URL backend yang dapat diakses oleh browser (logo, iklan, komentar, dan view count).
# Nilai NEXT_PUBLIC_* ditanam saat `next build`.
NEXT_PUBLIC_API_URL=http://localhost/koranku/api/v1

# Domain publik frontend untuk canonical URL, sitemap, dan robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contoh production:
# NEXT_PUBLIC_API_URL=https://api.domain-anda.com/api/v1
# NEXT_PUBLIC_SITE_URL=https://domain-anda.com

# Alternatif jika backend diproxy pada domain frontend yang sama.
# Hapus NEXT_PUBLIC_API_URL di atas, lalu aktifkan baris ini:
# NEXT_PUBLIC_API_PATH=/koranku/api/v1
